        "registryId": "NCT06144684",
        "overallStatus": "completed",
        "sourceStatus": "Completed",
        "statusUpdatedAt": "2026-01"
      },
      "design": {
        "randomization": "Randomized",
        "masking": "Double-blind within cohorts",
        "comparator": "Placebo",
        "description": "Single-center, two-part first-in-human study of single ascending doses in Part 1 and multiple ascending doses in Part 2; 76 participants were enrolled overall."
      },
      "population": "Adults aged 18 to 65 years who were lean, overweight, or obese but otherwise healthy; Part 1 enrolled men and Part 2 enrolled men and women, with BMI ranges varying by part from 22.0-32.0 kg/m2 to 27.0-35.0 kg/m2.",
      "overallDuration": "Part 1 through Day 29; Part 2 cohorts through Day 64, Day 120, or Day 127",
      "safetySummary": "In the 60-participant MAD analysis reported in the EASD 2026 abstract, ABBV-295 was generally well tolerated, with no serious treatment-emergent adverse events; gastrointestinal disorders were the most common adverse events, were mostly mild, and occurred predominantly during the first 6 weeks.",
